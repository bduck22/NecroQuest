    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\t\t\t\t\t\t\t\t\t\t  \uB124\uD06C\uB85C\uB9E8\uC11C\n\t\t\t\t\t\t\t\t\t\t 
    (\uCD5C\uC885\uBCF4\uC2A4)\n\n\n\n\uAE30\uBCF8 \uB2A5\uB825\uCE58\n1P) \uCCB4\uB825
    25 / \uC774\uB3D9\uC18D\uB3C4 5 \n\uD2B9\uC9D5 :  \uC9C0\uD615\uAD00\uD1B5 /
    \uACF5\uACA9\uBD88\uAC00 / 3\uCD08\uB9C8\uB2E4 \uB79C\uB364 \uBAAC\uC2A4\uD130
    \uBB34\uB9AC \uC18C\uD658 \n           \uC18C\uD658\uB418\uB294 \uBAA8\uB4E0
    \uBAAC\uC2A4\uD130\uC758 \uACF5\uACA9\uB825, \uCCB4\uB825 1.5\uBC30\n\t\t   \uC0AC\uB9DD\uC2DC
    \uD544\uB4DC\uC758 \uBAA8\uB4E0 \uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58 \uD6C4
    \uBD80\uD65C \uBC0F 2P \uC804\uD658\n\n2P) \uCCB4\uB825 25+(1P\uC5D0\uC11C \uCC98\uCE58\uD55C
    \uBAAC\uC2A4\uD130 \uC218*0.4) / \uACF5\uACA9\uB825 17 / \uC774\uB3D9\uC18D\uB3C4
    5\n      \uACF5\uACA9\uC18D\uB3C4 1 / \uC0AC\uAC70\uB9AC 4.5\n\uD2B9\uC9D5 : 
    \uC9C0\uD615\uAD00\uD1B5 / \uCD5C\uB300\uCCB4\uB825 60\uB2F9 1\uB9CC\uD07C \uCD94\uAC00\uD53C\uD574\n\t
    \t   \uC785\uD78C \uD53C\uD574\uB7C9\uC758  50%\uB9CC\uD07C \uD68C\uBCF5\n\t\t  
    \uC0AC\uB9DD \uC2DC \uC2A4\uD14C\uC774\uC9C0 \uD074\uB9AC\uC5B4\n"

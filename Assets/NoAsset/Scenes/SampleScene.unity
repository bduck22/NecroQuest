--- !u!114 &1629617694
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1629617692}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 1dc2f6b6b5d86af44bee66979cb3d3cf, type: 3}
    m_FontSize: 40
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 85
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uBAA8\uB4E0 \uC6A9\uBCD1\uC740 \"\uC0AC\uAE30\"\uB77C\uB294 \uACE0\uC720\uC758
    \uC218\uCE58\uB97C \uAC00\uC9D0\n\uC6A9\uBCD1\uC740 \uC0AC\uAE30 \uC218\uCE58\uC5D0
    \uBE44\uB840\uD558\uC5EC \uCD94\uAC00 \uBC84\uD504\uB098 \uB514\uBC84\uD504\uB97C
    \uD68D\uB4DD\n\uC0AC\uAE30 \uC218\uCE58\uC758 \uC99D\uAC10 \uC870\uAC74\n\uAC10\uC18C
    : \uB9E4\uCD08 \uB9C8\uB2E4 \uB09C\uC774\uB3C4\uC5D0 \uBE44\uB840 / \uD53C\uACA9
    \uC2DC -1 / \uC544\uAD70 \uC0AC\uB9DD \uC2DC -30\n\uC99D\uAC00 : \uBAAC\uC2A4\uD130
    \uCC98\uCE58 \uC2DC +5\n\n\n\n\n\n\n\uC0AC\uAE30\uC5D0 \uB530\uB978 \uD6A8\uACFC\n0~50
    : \uAC00\uD558\uB294 \uD53C\uD574 \uBC0F \uAC00\uD558\uB294 \uD68C\uBCF5\uB7C9
    10% \uAC10\uC18C\t| 151~200 : \uBAA8\uB4E0 \uAE30\uBCF8 \uB2A5\uB825\uCE58 +
    0.5\r\r\n \t\t    \uBC1B\uB294 \uCE58\uC720\uB7C9 10% \uAC10\uC18C\t\t\t\t\t\t\t\t|
    201~250 : \uAC00\uD558\uB294 \uD53C\uD574\uB7C9 \uBC0F \uAC00\uD558\uB294 \uD68C\uBCF5\uB7C9
    10% \uC99D\uAC00 \r\n \t\t    \uBC1B\uB294 \uD53C\uD574\uB7C9 10% \uC99D\uAC00\t\t\t\t\t\t\t\t|\t\t\t      
    \uBC1B\uB294 \uCE58\uC720\uB7C9 10% \uC99D\uAC00\n51~100 : \uC0AC\uAC70\uB9AC
    1 \uAC10\uC18C\t\t\t\t\t\t\t\t\t\t|\t\t\t       \uBC1B\uB294 \uD53C\uD574\uB7C9
    10% \uAC10\uC18C"

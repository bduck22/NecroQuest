  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 1dc2f6b6b5d86af44bee66979cb3d3cf, type: 3}
    m_FontSize: 40
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 85
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uBC1B\uB294 \uD53C\uD574\uB7C9 - \uD53C\uD574\uB97C \uBC1B\uC744 \uB54C\uC758
    \uAC00\uC911\uCE58\r\n\uAC00\uD558\uB294 \uD53C\uD574\uB7C9\uACFC \uAC00\uD558\uB294
    \uD68C\uBCF5\uB7C9 - \uBAA8\uB4E0 \uAC00\uD558\uB294 \uD53C\uD574\uB7C9\uACFC
    \uD68C\uBCF5\uB7C9\uC758 \uCD5C\uC885 \uAC00\uC911\uCE58\r\n\uBC1B\uB294 \uCE58\uC720\uB7C9
    - \uD68C\uBCF5\uC744 \uBC1B\uC744 \uB54C\uC758 \uAC00\uC911\uCE58\r\n\uC0AC\uAC70\uB9AC
    - \uBAAC\uC2A4\uD130\uB97C \uC778\uC2DD\uD558\uB294 \uAC70\uB9AC\r\n\uAE30\uBCF8\uACF5\uACA9
    \uD53C\uD574\uB7C9 - \uAE30\uBCF8\uACF5\uACA9\uC5D0 \uC801\uC6A9\uB418\uB294
    \uAC00\uC911\uCE58\r\n\uC2A4\uD0AC \uC704\uB825 - \uC2A4\uD0AC\uC5D0 \uC801\uC6A9\uB418\uB294
    \uAC00\uC911\uCE58\r\n\uC2A4\uD0AC\uCFE8\uD0C0\uC784 - \uC2A4\uD0AC \uC7AC\uC0AC\uC6A9
    \uB300\uAE30 \uC2DC\uAC04 (\uCD5C\uC18C 5\uCD08) \r\n\uBB34\uC801\uC2DC\uAC04
    - \uC6A9\uBCD1\uC774 \uD53C\uACA9 \uC2DC \uBB34\uC801\uC774 \uB418\uB294 \uC2DC\uAC04\n\uC0AC\uAE30
    \uD68C\uBCF5\uB7C9 - \uC0AC\uAE30\uB97C \uD68D\uB4DD\uD560 \uB54C\uC758 \uAC00\uC911\uCE58"
